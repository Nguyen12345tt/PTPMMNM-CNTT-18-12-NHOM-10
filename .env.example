# Cấu hình kết nối Cơ sở dữ liệu MySQL (Mẫu cấu hình - Không chứa mật khẩu thật)
# Sao chép tệp này thành .env nếu cần tùy chỉnh thông số kết nối MySQL trên máy cá nhân.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=timetable_db
DB_USERNAME=root
DB_PASSWORD=
DB_SOCKET=

# Chế độ ứng dụng
APP_ENV=development
APP_DEBUG=true
